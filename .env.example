# WebDNA server (apps/server)
WEBDNA_HOST=127.0.0.1
WEBDNA_PORT=4100
# Where scan records, reports and screenshots are stored (git-ignored)
WEBDNA_DATA_DIR=./data
# Maximum scans running at the same time and maximum queued scans
WEBDNA_MAX_CONCURRENCY=2
WEBDNA_MAX_QUEUE=20
# Delete scans older than this many days (0 disables automatic retention)
WEBDNA_RETENTION_DAYS=14
# Per-scan limits
WEBDNA_NAV_TIMEOUT_MS=30000
WEBDNA_SCAN_TIMEOUT_MS=180000
WEBDNA_MAX_TOTAL_BYTES=67108864
WEBDNA_MAX_REQUESTS=600
# Comma-separated ports the browser may connect to
WEBDNA_ALLOWED_PORTS=80,443,8080,8443
# Fail every DNS lookup (tests / air-gapped use). Only IP literals and allow-listed loopback work.
WEBDNA_OFFLINE_DNS=0
# Host names (any port) accepted in Host / X-Forwarded-Host (DNS-rebinding protection)
WEBDNA_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# DANGEROUS — development only. Comma-separated host:port pairs on loopback that
# may be scanned (used for local fixture sites). Never set this on a shared host.
WEBDNA_UNSAFE_ALLOW_LOOPBACK=

# Web app (apps/web)
WEBDNA_API_URL=http://127.0.0.1:4100
