{
  "signatureSet": "platforms",
  "version": "2026.10.0",
  "description": "CMS, website builder, framework, hosting and build-tool fingerprints. Platform identification is never, by itself, evidence of AI involvement.",
  "signatures": [
    {
      "id": "wordpress",
      "version": "1.0.0",
      "name": "WordPress",
      "subjectType": "cms",
      "status": "active",
      "provenance": {
        "type": "documented",
        "reference": "https://developer.wordpress.org/reference/functions/wp_generator/",
        "lastReviewed": "2026-10-29"
      },
      "description": "WordPress emits a generator meta tag by default and serves theme/plugin assets from /wp-content/ and /wp-includes/.",
      "matchers": [
        {
          "type": "meta",
          "name": "generator",
          "pattern": "^WordPress\\b",
          "strength": "strong",
          "kind": "direct",
          "explanation": "Default WordPress generator meta tag."
        },
        {
          "type": "asset_path",
          "pattern": "/wp-(content|includes)/",
          "strength": "moderate",
          "kind": "direct",
          "explanation": "Asset served from a WordPress core directory."
        },
        {
          "type": "dom_selector",
          "selector": "link[rel='https://api.w.org/']",
          "strength": "moderate",
          "kind": "direct",
          "explanation": "WordPress REST API discovery link."
        }
      ],
      "limitations": [
        "Generator tags are often removed by security plugins.",
        "Headless WordPress setups may expose none of these markers."
      ],
      "falsePositiveConsiderations": ["Static mirrors of WordPress sites keep /wp-content/ paths."]
    },
    {
