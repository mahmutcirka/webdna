{
  "name": "webdna",
  "version": "0.1.0",
  "private": true,
  "description": "Website intelligence and evidence-based AI-origin analysis.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @webdna/server\" \"npm run dev -w @webdna/web\"",
    "build": "npm run build -w @webdna/server && npm run build -w @webdna/web",
    "start": "concurrently -n server,web -c blue,magenta \"npm run start -w @webdna/server\" \"npm run start -w @webdna/web\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @webdna/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:detectors": "vitest run --project unit packages/detectors",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "eval": "tsx scripts/evaluate-detectors.ts",
    "sample-report": "tsx scripts/generate-sample-report.ts",
    "browsers:install": "playwright install chromium",
    "check:release": "tsx scripts/release-check.ts",
    "test:e2e": "playwright test",
    "verify:prod-host": "tsx scripts/verify-production-host-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
